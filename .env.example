# 环境变量模板
# 复制此文件以创建本地环境文件：
#   Windows PowerShell / CMD:  copy .env.example .env.development
#                             copy .env.example .env.production
#   macOS / Linux / Git Bash: cp .env.example .env.development
#                             cp .env.example .env.production
#
# 然后按各环境更新下方值。
# 真实的 .env.* 文件已被 Git 忽略，只有本模板会提交。

# 主进程与渲染进程共用的 API URL。
# 渲染进程访问方式：import.meta.env.VITE_API_URL
# 主进程访问方式：import { appEnv } from './core/env' -> appEnv.API_URL
VITE_API_URL=http://localhost:3000
MAIN_VITE_API_URL=http://localhost:3000

# 崩溃报告可选的 Sentry DSN（在 Phase 9 中使用）。
# MAIN_VITE_SENTRY_DSN=

# 自动更新可选的更新服务器 URL（在 Phase 12 中使用）。
# 设置后，打包应用将向该地址查询更新。
# 渲染进程访问方式：import.meta.env.VITE_UPDATE_URL
# 主进程访问方式：appEnv.UPDATE_URL
# VITE_UPDATE_URL=https://your-domain.com/updates
# MAIN_VITE_UPDATE_URL=https://your-domain.com/updates
